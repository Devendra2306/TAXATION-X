# ==========================================
# Core Application Settings
# ==========================================
PROJECT_NAME="NexTax Platform"
DATABASE_URL="postgresql://user:password@host:5432/dbname"
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# Authentication & Security
# ==========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="replace_with_strong_random_secret_minimum_32_characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Firebase Project ID (for verifying Google login ID tokens)
FIREBASE_PROJECT_ID="your-firebase-project-id"

# ==========================================
# AI & External Integrations
# ==========================================
GEMINI_API_KEY="your-gemini-api-key"

# External APIs for PAN Verification / E-Filing
EXTERNAL_API_KEY="your-external-api-key"
EXTERNAL_API_SECRET="your-external-api-secret"
# Sandbox ERI Endpoints (See docs/SANDBOX_ENDPOINTS.md for endpoint verification status)
SANDBOX_BASE_URL="https://api.sandbox.co.in"
SANDBOX_AUTH_ENDPOINT="/authenticate"
SANDBOX_PAN_VERIFY_ENDPOINT="/kyc/pan/verify"
# The following endpoints require an active ERI enterprise plan from Sandbox / ITD.
# In DEMO_MODE=false, unconfigured endpoints will be refused with HTTP 501.
SANDBOX_GENERATE_OTP_ENDPOINT=""
SANDBOX_PREFILL_ENDPOINT=""
SANDBOX_SUBMIT_ENDPOINT=""
SANDBOX_EVERIFY_ENDPOINT=""
SANDBOX_STATUS_ENDPOINT=""
# Demo mode: false = production (strict errors on API failure), true = return simulated data
DEMO_MODE=false

# ==========================================
# Monitoring & Error Tracking
# ==========================================
SENTRY_DSN=""

