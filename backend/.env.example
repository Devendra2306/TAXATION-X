# ==========================================
# Core Application Settings
# ==========================================
PROJECT_NAME="NexTax Platform"
DATABASE_URL="postgresql://user:password@host:5432/dbname"
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# Authentication & Security
# ==========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="replace_with_strong_random_secret_minimum_32_characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Firebase Project ID (for verifying Google login ID tokens)
FIREBASE_PROJECT_ID="your-firebase-project-id"

# ==========================================
# AI & External Integrations
# ==========================================
GEMINI_API_KEY="your-gemini-api-key"

# External APIs for PAN Verification / E-Filing
EXTERNAL_API_KEY="your-external-api-key"
EXTERNAL_API_SECRET="your-external-api-secret"

# ==========================================
# Monitoring & Error Tracking
# ==========================================
SENTRY_DSN=""

