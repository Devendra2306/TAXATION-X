# OFS Taxation Platform - Environment Variables

# ==========================================
# Core Application Settings
# ==========================================
PROJECT_NAME="OFS Taxation Platform"
# URL for the local Postgres database spun up via Docker Compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ofs_tax"
# URL for the local Redis instance spun up via Docker Compose
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# Authentication (Supabase / Auth0)
# ==========================================
# Get these from your Supabase Project Settings > API
AUTH_PROVIDER_URL="your-supabase-url"
AUTH_PROVIDER_KEY="your-supabase-anon-key"

# ==========================================
# Amazon Web Services (AWS S3 for Document Storage)
# ==========================================
# Create an IAM user with S3 upload permissions and get these keys
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_BUCKET_NAME="ofs-tax-documents-prod"
AWS_REGION="ap-south-1" # Usually Mumbai for Indian clients

# ==========================================
# WhatsApp Bot (Meta Cloud API) - Pending Client Approval
# ==========================================
# These will be required when we activate Phase 4
WHATSAPP_TOKEN="your-meta-system-user-token"
WHATSAPP_PHONE_ID="your-phone-number-id"
WHATSAPP_VERIFY_TOKEN="your-custom-webhook-verify-token"

# ==========================================
# Monitoring & Error Tracking
# ==========================================
# Get this from Sentry.io project settings
SENTRY_DSN="your-sentry-dsn-url"
