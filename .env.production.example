# OFS Taxation Platform - Production Environment Variables
# Copy this file to `.env.production` before running docker-compose up

# ==========================================
# Core Application Settings
# ==========================================
PROJECT_NAME="OFS Taxation Platform"
SECRET_KEY=your_random_secret_key_here

# Inside Docker Compose, the backend connects to the 'postgres' and 'redis' service names
DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/ofs_tax"
REDIS_URL="redis://redis:6379/0"

# ==========================================
# Firebase / Authentication
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ==========================================
# AWS S3 (Document Storage)
# ==========================================
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_BUCKET_NAME="ofs-tax-documents-prod"
AWS_REGION="ap-south-1"

# ==========================================
# External APIs
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
EXTERNAL_API_KEY=your_external_api_key_here
EXTERNAL_API_SECRET=your_external_api_secret_here
SANDBOX_BASE_URL="https://api.sandbox.co.in"
SANDBOX_PAN_VERIFY_ENDPOINT="/kyc/pan/verify"
SANDBOX_GENERATE_OTP_ENDPOINT="/tax/itr/generate-otp"
SANDBOX_PREFILL_ENDPOINT="/tax/itr/prefill"
SANDBOX_SUBMIT_ENDPOINT="/tax/itr/submit"
SANDBOX_EVERIFY_ENDPOINT="/tax/itr/e-verify"
SANDBOX_STATUS_ENDPOINT="/tax/itr/status"
# Demo mode: false = production (strict errors on API failure), true = return simulated data
DEMO_MODE=false
WHATSAPP_TOKEN="your-meta-system-user-token"
WHATSAPP_PHONE_ID="your-phone-number-id"
WHATSAPP_VERIFY_TOKEN="your-custom-webhook-verify-token"

# ==========================================
# Monitoring
# ==========================================
SENTRY_DSN="your-sentry-dsn-url"
